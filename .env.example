# ── Copy this file to .env and fill in your values ────────────────────────────
# NEVER commit .env to git.

# ── Schwab Developer App (https://developer.schwab.com) ──────────────────────
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
# Must match the callback URL registered in your Schwab app
SCHWAB_CALLBACK_URL=https://127.0.0.1

# Run `python -m trading_bot.main --authorize` then call GET /accounts to find
# your encrypted account hash (not the plain account number).
SCHWAB_ACCOUNT_HASH=your_encrypted_account_hash_here

# ── Webhook server ─────────────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Optional — set a secret and include it in every TradingView alert body
WEBHOOK_SECRET=change_me_to_something_random

# ── Risk management ────────────────────────────────────────────────────────────
# Stop-loss % below entry when no explicit stop price is given (0.02 = 2%)
DEFAULT_STOP_LOSS_PCT=0.02
# Default number of shares per trade
DEFAULT_QUANTITY=1
# Set to true to log orders without actually submitting them
DRY_RUN=false
